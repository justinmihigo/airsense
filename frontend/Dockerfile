FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci

# Declare every VITE_ variable as a build-time arg.
# Vite reads process.env at build time, so ARG must be promoted to ENV
# before npm run build executes.
ARG VITE_API_URL
ARG VITE_ML_API_URL
ARG VITE_INFLUX_URL
ARG VITE_INFLUX_BUCKET
ARG VITE_INFLUX_ORG
ARG VITE_INFLUX_TOKEN
ARG VITE_INFLUX_MEASUREMENT
ARG VITE_MQTT_URL
ARG VITE_MQTT_TOPIC
ARG VITE_GOOGLE_MAPS_KEY

ENV VITE_API_URL=$VITE_API_URL \
    VITE_ML_API_URL=$VITE_ML_API_URL \
    VITE_INFLUX_URL=$VITE_INFLUX_URL \
    VITE_INFLUX_BUCKET=$VITE_INFLUX_BUCKET \
    VITE_INFLUX_ORG=$VITE_INFLUX_ORG \
    VITE_INFLUX_TOKEN=$VITE_INFLUX_TOKEN \
    VITE_INFLUX_MEASUREMENT=$VITE_INFLUX_MEASUREMENT \
    VITE_MQTT_URL=$VITE_MQTT_URL \
    VITE_MQTT_TOPIC=$VITE_MQTT_TOPIC \
    VITE_GOOGLE_MAPS_KEY=$VITE_GOOGLE_MAPS_KEY

COPY . .
RUN npm run build

FROM node:20-alpine
RUN npm install -g serve
WORKDIR /app
COPY --from=builder /app/dist ./dist
EXPOSE 3000
CMD ["serve", "-s", "dist", "-l", "3000"]
